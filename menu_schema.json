{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Radial Menu Data Schema",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": { "$ref": "#/definitions/menuItem" }
    }
  },
  "required": ["items"],
  "definitions": {
    "menuItem": {
      "type": "object",
      "properties": {
        "label": { "type": "string" },
        "type": { "enum": ["text", "submenu"] },
        "content": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/menuItem" }
        }
      },
      "required": ["label", "type"],
      "if": {
        "properties": { "type": { "const": "text" } }
      },
      "then": {
        "required": ["content"]
      },
      "else": {
        "required": ["items"]
      }
    }
  }
}
